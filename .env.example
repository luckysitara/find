# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# Public Supabase URL (Found in Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anonymous Key (Found in Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Supabase URL override (Optional, defaults to NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Server-side Supabase Anon Key override (Optional, defaults to NEXT_PUBLIC_SUPABASE_ANON_KEY)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Required for server-side admin actions bypassing RLS, e.g. user creation)
# CAUTION: Keep this key secret and never expose it to the browser!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# SOLANA & WALLET CONFIGURATION
# ==========================================
# Solana Network environment: "devnet", "testnet", or "mainnet-beta" (Defaults to "devnet" in dev)
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Custom Solana RPC Endpoint (Optional, defaults to public cluster RPC URL)
# Example: https://api.devnet.solana.com or custom RPC provider (e.g. Helius / QuickNode)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana Merchant Wallet Address for receiving subscription and payment transactions
NEXT_PUBLIC_MERCHANT_WALLET=11111111111111111111111111111112

# ==========================================
# SUBSCRIPTION PRICING (EUR)
# ==========================================
# Investigator Plan Pricing
NEXT_PUBLIC_PRICE_INVESTIGATOR_MONTHLY=300
NEXT_PUBLIC_PRICE_INVESTIGATOR_YEARLY=2500

# Pro Plan Pricing
NEXT_PUBLIC_PRICE_PRO_MONTHLY=1000
NEXT_PUBLIC_PRICE_PRO_YEARLY=12000

